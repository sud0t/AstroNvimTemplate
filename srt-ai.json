{
  "network": {
    "allowedDomains": [],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "~/Private",
      "~/.local/share/keyrings",
      "~/.config/keepassxc",
      "~/.local/state/keepassxc",
      "~/.config/librewolf",
      "~/.config/mozilla",
      "~/.mozilla",
      "~/.config/google-chrome",
      "~/.local/state/noctalia",
      "~/.ssh",
      "~/.gnupg",
      "~/.pki",
      "~/.password-store",
      "~/.netrc",
      "~/.git-credentials",
      "~/.config/git/credentials",
      "~/.config/gh",
      "~/.npmrc",
      "~/.pypirc",
      "~/.cargo/credentials.toml",
      "~/.docker/config.json",
      "~/.aws",
      "~/.azure",
      "~/.kube",
      "~/.config/gcloud",
      "~/.config/anthropic",
      "~/.ollama/id_ed25519",
      "~/.thunderbird",
      "~/.config/discord",
      "~/.zsh_history",
      "~/.bash_history",
      "~/.python_history",
      "~/.node_repl_history",
      "~/.viminfo",
      "~/.claude/.credentials.json",
      "~/.claude.json",
      "~/.claude/history.jsonl",
      "~/.claude/projects",
      "~/.claude/file-history",
      "~/.claude/settings.json",
      "~/.claude/session-env",
      "~/.claude/shell-snapshots",
      "~/.gradle/gradle.properties",
      "~/.config/obsidian",
      "~/.local/state/nvim",
      "~/.local/share/nvim/codecompanion",
      "/tmp/dbus-*",
      "/tmp/.X11-unix",
      "/tmp/nvim.kylr",
      "/run/user/1000"
    ],
    "allowRead": [],
    "allowWrite": ["."],
    "denyWrite": [
      "~/.config/nvim",
      "~/.local/share/nvim",
      "~/.local/state/nvim",
      "~/.cache/nvim",
      "~/.claude",
      "~/.claude.json",
      "~/.config/codecompanion",
      "~/.agents",
      "~/.local/bin",
      "~/.local/lib/node_modules",
      "~/.config/autostart",
      "~/.config/systemd",
      "~/.config/environment.d",
      "~/.config/git",
      "~/.local/share/systemd",
      "~/.local/share/applications"
    ]
  },
  "credentials": {
    "envVars": [
      { "name": "DBUS_SESSION_BUS_ADDRESS", "mode": "deny" },
      { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
      { "name": "OPENAI_API_KEY", "mode": "deny" },
      { "name": "GEMINI_API_KEY", "mode": "deny" },
      { "name": "GOOGLE_API_KEY", "mode": "deny" },
      { "name": "OPENROUTER_API_KEY", "mode": "deny" },
      { "name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny" }
    ]
  }
}
